# Base de datos (ver docker-compose.yml)
DATABASE_URL=postgresql://requimeet:requimeet@localhost:5432/requimeet

# JWT de sesiones de anfitrion e invitados (solo servidor)
JWT_SECRET=change-me-in-real-deployments
JWT_HOST_TTL=12h
# Los tokens de invitado son de corta duracion; el frontend los renueva
GUEST_TOKEN_TTL=30m

# LiveKit (credenciales SOLO en servidor; coinciden con docker-compose.yml)
# LIVEKIT_NODE_IP: IP anunciada en candidatos ICE. 127.0.0.1 para uso local;
# la IP LAN de esta maquina para probar desde otros dispositivos.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# TTL corto: al expulsar, el token viejo muere rapido (LiveKit OSS no revoca tokens)
LIVEKIT_TOKEN_TTL=5m

# Secreto compartido backend <-> processor (endpoints internos)
INTERNAL_SHARED_SECRET=dev-internal-secret

# Processor (proceso separado, mismo repo)
PROCESSOR_PORT=4100
# Endpoint del backend donde el processor publica resultados
SERVER_INTERNAL_URL=http://localhost:3000
# Endpoint del processor donde el backend ordena iniciar/detener procesamiento
PROCESSOR_INTERNAL_URL=http://localhost:4100
# Consumir video ademas de audio (opcional, por defecto solo audio)
PROCESSOR_ENABLE_VIDEO=false
# API key de Deepgram para transcripcion en vivo 
DEEPGRAM_API_KEY=

# Backend
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Frontend (unicas variables expuestas al navegador)
VITE_SERVER_URL=http://localhost:3000
VITE_LIVEKIT_URL=ws://localhost:7880
