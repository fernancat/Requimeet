generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HostUser {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  displayName  String
  createdAt    DateTime      @default(now())
  meetings     Meeting[]
  participants Participant[]
}

model Meeting {
  id                 String              @id @default(uuid())
  code               String              @unique
  title              String
  hostId             String
  host               HostUser            @relation(fields: [hostId], references: [id])
  status             String              @default("created")
  createdAt          DateTime            @default(now())
  startedAt          DateTime?
  endedAt            DateTime?
  joinRequests       JoinRequest[]
  participants       Participant[]
  messages           ChatMessage[]
  transcriptSegments TranscriptSegment[]
  requirements       Requirement[]
  aiJobs             AiJob[]
  questions          Question[]
}

model GuestSession {
  id           String        @id @default(uuid())
  displayName  String
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  joinRequests JoinRequest[]
  participants Participant[]
}

model JoinRequest {
  id             String       @id @default(uuid())
  meetingId      String
  meeting        Meeting      @relation(fields: [meetingId], references: [id])
  guestSessionId String
  guestSession   GuestSession @relation(fields: [guestSessionId], references: [id])
  displayName    String
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?
  decidedById    String?

  @@index([meetingId, status])
}

model Participant {
  id                 String              @id @default(uuid())
  meetingId          String
  meeting            Meeting             @relation(fields: [meetingId], references: [id])
  hostUserId         String?
  hostUser           HostUser?           @relation(fields: [hostUserId], references: [id])
  guestSessionId     String?
  guestSession       GuestSession?       @relation(fields: [guestSessionId], references: [id])
  displayName        String
  role               String
  state              String              @default("admitted")
  joinedAt           DateTime            @default(now())
  leftAt             DateTime?
  messages           ChatMessage[]
  transcriptSegments TranscriptSegment[]

  @@index([meetingId])
}

model ChatMessage {
  id                  String      @id @default(uuid())
  meetingId           String
  meeting             Meeting     @relation(fields: [meetingId], references: [id])
  authorParticipantId String
  author              Participant @relation(fields: [authorParticipantId], references: [id])
  authorName          String
  body                String
  clientRef           String
  createdAt           DateTime    @default(now())

  @@unique([meetingId, authorParticipantId, clientRef])
}

enum RequirementStatus {
  PENDING
  CORRECTED
  APPROVED
}

model TranscriptSegment {
  id            String   @id @default(uuid())
  resultId      String   @unique
  meetingId     String
  participantId String?
  trackSid      String?
  text          String
  originalText  String?
  revision      Int      @default(1)
  isFinal       Boolean  @default(true)
  analyzedRevision Int @default(0)
  edited        Boolean  @default(false)
  trackStartMs  Float?
  trackEndMs    Float?
  history       Json     @default("[]")
  startMs       Float?
  endMs         Float?
  createdAtMs   Float
  createdAt     DateTime @default(now())

  meeting      Meeting       @relation(fields: [meetingId], references: [id])
  participant  Participant?  @relation(fields: [participantId], references: [id])
  requirements Requirement[]

  @@index([meetingId, createdAt])
}

model Requirement {
  id                  String            @id @default(uuid())
  meetingId           String
  transcriptSegmentId String?
  originalText        String
  sourceIds           String[]          @default([])
  version             Int               @default(1)
  discarded           Boolean           @default(false)
  history             Json              @default("[]")
  text                String
  status              RequirementStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  meeting           Meeting           @relation(fields: [meetingId], references: [id])
  transcriptSegment TranscriptSegment? @relation(fields: [transcriptSegmentId], references: [id])

  @@unique([transcriptSegmentId, originalText])
  @@index([meetingId, status])
  @@index([transcriptSegmentId])
}

model AiJob {
  id String @id @default(uuid())
  meetingId String
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind String @default("analysis")
  fingerprint String
  status String @default("queued")
  input Json
  output Json?
  attempts Int @default(0)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([meetingId, kind, fingerprint])
  @@index([status, createdAt])
}
model Question {
  id String @id @default(uuid())
  meetingId String
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text String
  normalizedText String
  category String
  reason String
  priority String
  sourceIds String[]
  status String @default("PENDING")
  answer String @default("")
  evidenceIds String[] @default([])
  version Int @default(1)
  history Json @default("[]")
  createdAt DateTime @default(now())
  @@unique([meetingId, normalizedText])
}
